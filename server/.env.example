# ---------- Local development ----------
PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=your_mysql_password
DB_NAME=readingradical
JWT_SECRET=change_me_to_a_long_random_string
CORS_ORIGINS=http://localhost:5173

# ---------- Railway (set these in the API service's Variables tab, not in a file) ----------
# DB_HOST=${{MySQL.MYSQLHOST}}
# DB_PORT=${{MySQL.MYSQLPORT}}
# DB_USER=${{MySQL.MYSQLUSER}}
# DB_PASS=${{MySQL.MYSQLPASSWORD}}
# DB_NAME=${{MySQL.MYSQLDATABASE}}
# JWT_SECRET=<long random string>
# CORS_ORIGINS=https://reading-radical.vercel.app
# (PORT is provided by Railway automatically. "MySQL" must match your database service's name.)

# Optional TLS for external MySQL providers:
# DB_SSL=true
# DB_SSL_CA=
