# ---------- SOURCE: the operational MySQL database (read-only access is enough) ----------
# Same variable names the Express app uses, so you can reuse the same values.
DB_HOST=localhost
DB_PORT=3306
DB_USER=readonly_user
DB_PASS=change_me
DB_NAME=readingradical
# Set DB_SSL=true for hosted MySQL that requires TLS (e.g. Aiven); DB_SSL_CA = CA certificate PEM text
# (single line with \n escapes is fine).
# DB_SSL=true
# DB_SSL_CA=

# ---------- WAREHOUSE: a SEPARATE PostgreSQL database ----------
WAREHOUSE_HOST=localhost
WAREHOUSE_PORT=5432
WAREHOUSE_USER=warehouse_user
WAREHOUSE_PASSWORD=change_me
WAREHOUSE_NAME=reading_radical_dw
# disable | allow | prefer | require | verify-ca | verify-full   (default: prefer)
# WAREHOUSE_SSLMODE=require
# Alternatively one SQLAlchemy URL instead of the five lines above:
# WAREHOUSE_URL=postgresql+psycopg://user:password@host:5432/dbname

# ---------- Pipeline tuning (all optional) ----------
# ETL_BATCH_SIZE=500          rows per batch / transaction (1-10000)
# ETL_SETTLE_SECONDS=60       ignore reviews newer than this, so in-flight inserts can commit first
# ETL_MAX_RETRIES=3           attempts for transient connection errors
# ETL_RETRY_BASE_DELAY=1.0    seconds, doubled after each failed attempt
# ETL_CONNECT_TIMEOUT=10      seconds
# ETL_STATEMENT_TIMEOUT_MS=60000
# ETL_LOG_LEVEL=INFO
